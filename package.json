{
  "name": "agentic-ps-platform",
  "version": "0.1.1",
  "private": true,
  "description": "Агентная платформа платёжной системы: ADP, журнал согласий, ПАО, эмуляторы окружения",
  "type": "module",
  "exports": {
    "./stand": {
      "types": "./dist/stand/index.d.ts",
      "default": "./dist/stand/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/main.*",
    "config/params.stand.json"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "scan:secrets": "python3 .claude/hooks/scan_secrets.py .",
    "gen:shared": "node scripts/gen-shared.mjs",
    "gen:shared:check": "node scripts/gen-shared.mjs --check",
    "test:install": "node scripts/check-install.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@kuzin4u/agentic-core": "git+https://github.com/kuzin4u/agentic-core.git#v0.2.1",
    "fastify": "^5.12.5"
  }
}
